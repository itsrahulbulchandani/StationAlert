# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'AwesomeProject' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'react-native-geolocation', :path => '../node_modules/@react-native-community/geolocation'
  pod 'RNCPushNotificationIOS', :path => '../node_modules/@react-native-community/push-notification-ios'

  # Add permissions
  require_relative '../node_modules/react-native-permissions/scripts/setup'
  setup_permissions([
    'Notifications',
    'LocationAccuracy',
    'LocationAlways',
    'LocationWhenInUse'
  ])

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
      end
    end

    # Xcode 16+/26 clang miscompiles fmt's consteval format-string checks
    # ("call to consteval function ... is not a constant expression"). fmt's
    # FMT_USE_CONSTEVAL block in base.h is not guarded by #ifndef, so a -D flag
    # can't override it; force the first branch true so it selects the
    # consteval-off path. Re-applied here so it survives `pod install`.
    fmt_base = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      original = "#if !defined(__cpp_lib_is_constant_evaluated)"
      patched  = "#if 1 || !defined(__cpp_lib_is_constant_evaluated)"
      if contents.include?(original)
        File.write(fmt_base, contents.sub(original, patched))
        Pod::UI.puts "[fmt] Disabled consteval for Xcode compatibility".green
      end
    end
  end
end
